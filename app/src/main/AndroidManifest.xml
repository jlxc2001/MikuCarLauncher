<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:theme="@style/AppTheme"
        android:label="MikuCarLauncher"
        android:icon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".AppListActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".MineActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".DesktopSettingsActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".AppPickerActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".HiddenAppsActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".AppDrawerSettingsActivity"
            android:screenOrientation="landscape"
            android:exported="false" />
        <activity
            android:name=".WidgetPickerActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    
        <service
            android:name=".MusicNotificationListenerService"
            android:label="MikuCarLauncher 音乐信息读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
